APP_HOST=127.0.0.1
APP_PORT=8018
APP_ENV=development
LOG_LEVEL=INFO

DATA_DIR=./data
LOG_DIR=./logs
STORAGE_DIR=./storage
TASK_STATE_DIR=./storage/tasks
REPORT_OUTPUT_DIR=./storage/reports
SKILL_ROOT_DIR=./skills
ASSESSMENT_CONFIG_PATH=./config/assessment_config.yaml

ASYNC_FILE_COUNT_THRESHOLD=10
ASYNC_TOTAL_SIZE_THRESHOLD_MB=10
MAX_FILE_COUNT=2000
MAX_PATH_LENGTH=260
MAX_FIELD_LENGTH=2000

OCR_PROVIDER=auto
OCR_EXECUTION_ENABLED=false
OCR_FAIL_ON_ERROR=false
OCR_COMMAND=
PADDLEOCR_EXECUTABLE=
PADDLEOCR_LANG=ch
MINERU_EXECUTABLE=
MINERU_OUTPUT_DIR=./storage/ocr
OCR_RENDER_SCALE=2.0
OCR_TIMEOUT_SECONDS=600
OCR_VISION_CHAR_THRESHOLD=200
VISION_COLOR_STD_THRESHOLD=30
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
MULTIMODAL_MODEL=mimo-v2.5

IMDR_DOCUMENTS_DIR=
IMDR_QUESTIONS_PATH=
IMDR_VALIDATION_OUTPUT=./storage/reports/imdr_validation_report.json
