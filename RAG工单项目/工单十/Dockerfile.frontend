# RAG 金融问答系统 - Frontend Dockerfile
# 使用 Nginx 提供静态文件服务

FROM nginx:alpine

# 复制前端构建产物
COPY frontend/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1
