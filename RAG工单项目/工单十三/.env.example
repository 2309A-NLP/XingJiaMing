# DeepSeek LLM
MIMO_API_KEY=
MIMO_BASE_URL=https://api.deepseek.com/v1
MIMO_MODEL=deepseek-chat

# Embedding models
EMBEDDING_MODEL_PATH=E:\AI_models\BGE-M3
EMBEDDING_MODELS=bge-m3:E:\AI_models\BGE-M3,m3e:E:\AI_models\model-m3e-base
DEFAULT_EMBEDDING_MODEL=bge-m3

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_workorder13

# Data and runtime storage
DATA_DIR=./data
STORAGE_DIR=./storage
LIGHTRAG_WORKING_DIR=./lightrag_storage
PERF_REPORT_DIR=./docs/perf

# Rerank
RERANK_ENABLED=true
RERANK_MODEL_PATH=E:\AI_models\bge-reranker-base
RERANK_CANDIDATE_K=12

# API server
API_HOST=0.0.0.0
API_PORT=8013

# Response optimization
MAX_CONTEXT_CHARS=3200
MAX_COMPLETION_TOKENS=480

# Optional document selector
DATA_FILE=

# Vision model
VISION_API_KEY=
VISION_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
VISION_MODEL=mimo-v2.5
VISION_ENABLED=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# LightRAG / Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_WORKSPACE=workorder13
