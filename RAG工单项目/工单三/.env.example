# DeepSeek LLM 配置
MIMO_API_KEY=
MIMO_BASE_URL=https://api.deepseek.com/v1
MIMO_MODEL=deepseek-chat

# Embedding 模型配置
EMBEDDING_MODEL_PATH=

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_workorder3

# 数据目录
DATA_DIR=./data

# Rerank 配置（可选关闭）
RERANK_ENABLED=true
RERANK_MODEL_PATH=

# 服务器配置
API_HOST=0.0.0.0
API_PORT=8003

# 数据文件（指定加载哪个文档，留空则加载最新的）
DATA_FILE=
